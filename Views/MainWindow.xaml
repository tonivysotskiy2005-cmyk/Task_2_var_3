<Window x:Class="ChessApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ChessApp.ViewModels"
        Title="Шахматные фигуры — MVVM" Height="520" Width="700"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель: список фигур -->
        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="Фигуры" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
            <ListBox ItemsSource="{Binding Pieces}"
                     SelectedItem="{Binding SelectedPiece}"
                     Margin="0,0,12,0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="13"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Правая панель -->
        <DockPanel Grid.Column="1">
            <!-- Информация о выбранной фигуре -->
            <Border DockPanel.Dock="Top" Background="#F0F0F0" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                <TextBlock Text="{Binding SelectedPieceInfo}" FontSize="14" TextWrapping="Wrap"/>
            </Border>

            <!-- Ввод хода -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Ход (напр. E4):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Text="{Binding TargetInput, UpdateSourceTrigger=PropertyChanged}"
                         Width="60" FontSize="14" VerticalContentAlignment="Center" Padding="4,2"
                         CharacterCasing="Upper"/>
                <Button Content="Сделать ход" Command="{Binding MoveCommand}" Margin="8,0,0,0" Padding="12,4"/>
                <Button Content="Сброс" Command="{Binding ResetCommand}" Margin="8,0,0,0" Padding="12,4"/>
            </StackPanel>

            <!-- Лог -->
            <TextBlock DockPanel.Dock="Top" Text="Журнал ходов" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Log, Mode=OneWay}" IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                     FontSize="12" Background="#FAFAFA"/>
        </DockPanel>
    </Grid>
</Window>
